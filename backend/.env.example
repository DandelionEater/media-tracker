# Local-only configuration. Copy this to backend/.env for local web/Electron runs.

# Optional: override where SQLite creates/opens the database file.
# Production defaults to /home/u145628270/domains/api.seenary.app/data/media.db.
# DATABASE_PATH=

ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# Hosted web callback defaults to API_PUBLIC_ORIGIN/auth/anilist/callback.
# ANILIST_REDIRECT_URI=http://localhost:3000/auth/anilist/callback

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Set this only when the API is behind a trusted reverse proxy that overwrites
# X-Forwarded-For. It lets per-client rate limiting use the original address.
# TRUST_PROXY=true
# RPC_RATE_LIMIT_MAX=300
# RPC_RATE_LIMIT_WINDOW_MS=60000
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=900000

# SQLite online backups default to every 24 hours with seven retained copies.
# Set the interval or retention to 0 to disable them.
# DB_BACKUP_INTERVAL_HOURS=24
# DB_BACKUP_RETENTION=7
# DB_BACKUP_DIRECTORY=

MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=http://localhost:3000/auth/mal/callback

# At least 32 random characters. Used only to derive month-scoped anonymous
# engagement keys; changing it intentionally breaks cross-record linkage.
ANALYTICS_HMAC_SECRET=

# Protects the private aggregate dashboard at /reports. The route returns 404
# until both are configured. Use a unique password of at least 16 characters.
ANALYTICS_REPORT_USERNAME=
ANALYTICS_REPORT_PASSWORD=

# Comma-separated local frontend origins allowed by the backend API.
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Maximum JSON RPC request body size. Text/PDF imports need room for file contents.
# MAX_RPC_BODY_BYTES=41943040
