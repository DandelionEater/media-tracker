{
  "name": "seenary",
  "version": "0.1.3",
  "description": "Anime and media tracking desktop app.",
  "main": "main.js",
  "scripts": {
    "start": "node server.js",
    "desktop": "node scripts/start-electron.js",
    "rebuild:node": "npm rebuild better-sqlite3 argon2",
    "rebuild:electron": "electron-rebuild -f",
    "build:frontend": "npm --prefix ../frontend run build",
    "pack": "npm run build:frontend && electron-builder --dir",
    "dist": "node scripts/build-release.js"
  },
  "keywords": [],
  "author": "Dainius Genzuras",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "argon2": "^0.41.1",
    "better-sqlite3": "^12.8.0",
    "electron-updater": "^6.8.3",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "electron": "^41.0.3",
    "electron-builder": "^26.0.12",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "app.seenary.desktop",
    "productName": "Seenary",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "../release"
    },
    "files": [
      "desktop-main.js",
      "desktop-preload.js",
      "updater.js",
      "scripts/write-release-notes.js",
      "tray.js",
      "shortcuts.js",
      "icon.png"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://api.seenary.app/desktop-updates"
      }
    ],
    "extraMetadata": {
      "main": "desktop-main.js",
      "dependencies": {
        "electron-updater": "^6.8.3"
      }
    },
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Seenary"
    }
  }
}
